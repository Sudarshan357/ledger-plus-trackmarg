{
  "name": "ledger-plus",
  "private": true,
  "version": "1.0.0",
  "description": "Ledger+ \u2014 partnership accounting on the Trackmarg Group Code system",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch backend/src/index.ts",
    "build": "npm run build:info && npm run build:web",
    "build:info": "node scripts/build-info.mjs",
    "build:web": "tsc -b && vite build",
    "build:backend": "tsc -p backend/tsconfig.json",
    "start": "npm run build:info && npm run build:web && npm run build:backend && node backend/dist/index.js",
    "start:public": "npm run build:info && npm run build:web && npm run build:backend && concurrently -n api,tunnel -c blue,magenta \"node backend/dist/index.js\" \"npm:tunnel\"",
    "server": "npm run build:backend && node backend/dist/index.js",
    "deploy": "node scripts/deploy.mjs",
    "watch": "node scripts/watch-deploy.mjs",
    "tunnel": "cloudflared tunnel --url http://localhost:4000",
    "preview": "vite preview",
    "db:generate": "prisma generate",
    "db:migrate": "tsx backend/src/scripts/applyMigrations.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -b --noEmit && tsc -p backend/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.2",
    "pg": "^8.22.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.7.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.20.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react-swc": "^3.10.2",
    "concurrently": "^9.1.2",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
}
