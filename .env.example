# Copy to .env and fill in. Never commit the real .env.
#
# Ledger+ shares the Trackmarg transport app's Supabase database and SESSION_SECRET on
# purpose: public.Group / public.User / public.Session are the shared Trackmarg tables, and
# Ledger+ owns only the tables in the separate `ledger` schema.

# Supabase dual-URL pattern: pooled (6543) for runtime queries, direct (5432) for DDL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Must match the transport app's value so both apps agree on account credentials.
# Ledger+ derives its own signing key from this, so its tokens are not interchangeable
# with transport tokens.
SESSION_SECRET=

PORT=4000

# Leave empty unless the frontend is hosted apart from its API (LAN address, tunnel).
VITE_API_URL=

# Enables the support console at /#/support. Leave unset to disable it entirely.
LEDGER_SUPPORT_PASSWORD=
