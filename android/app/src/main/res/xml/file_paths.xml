<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-path name="my_images" path="." />
    <cache-path name="my_cache_images" path="." />
    <!-- Where UpdateInstallerPlugin downloads a release APK. The system installer runs as a
         different process, so it can only read the file through a FileProvider grant - a bare
         file:// URI throws FileUriExposedException on Android 7 and up. -->
    <external-files-path name="updates" path="updates/" />
</paths>
